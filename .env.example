# --- Supabase ---------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=
# Use the SERVICE ROLE key (server-side only, never ship it to a browser).
SUPABASE_KEY=
SUPABASE_TABLE=scan_results
# Set to false to run the engine without persisting anything (useful for tests).
PERSIST_RESULTS=true

# --- Scanner ----------------------------------------------------------------
# Comma separated recursive resolvers. Cloudflare + Google both validate DNSSEC.
DNS_RESOLVERS=1.1.1.1,8.8.8.8
DNS_TIMEOUT=5.0
DNS_LIFETIME=10.0
# Warn (status=warn) when a DNSSEC signature expires within this many days.
DNSSEC_EXPIRY_WARNING_DAYS=14
# Warn when the TLS certificate expires within this many days.
TLS_EXPIRY_WARNING_DAYS=30
TLS_TIMEOUT=8.0

# --- API --------------------------------------------------------------------
LOG_LEVEL=INFO
# Shared secret. When set, callers must send  X-API-Key: <value>
# Optional locally; deploy/deploy.sh refuses to deploy without it.
API_KEY=

# --- Production (docker-compose.prod.yml) -----------------------------------
# Hostname Caddy obtains a TLS certificate for. Must already resolve to this
# instance before the first deploy, or the ACME challenge fails.
SCANNER_DOMAIN=
# Address Let's Encrypt sends expiry warnings to. Optional but recommended.
ACME_EMAIL=
