# --- Supabase ---------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=
# Use the SERVICE ROLE key (server-side only, never ship it to a browser).
SUPABASE_KEY=
SUPABASE_TABLE=scan_results
# Set to false to run the engine without persisting anything (useful for tests).
PERSIST_RESULTS=true

# --- Scanner ----------------------------------------------------------------
# Comma separated recursive resolvers. Cloudflare + Google both validate DNSSEC.
DNS_RESOLVERS=1.1.1.1,8.8.8.8
DNS_TIMEOUT=5.0
DNS_LIFETIME=10.0

# --- API --------------------------------------------------------------------
LOG_LEVEL=INFO
# Optional shared secret. When set, callers must send  X-API-Key: <value>
API_KEY=
